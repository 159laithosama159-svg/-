rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStringList(arr, maxLen) {
      return arr is list &&
        arr.size() <= maxLen &&
        (arr.size() == 0 || arr[0] is string);
    }

    function isValidMapList(arr, maxLen) {
      return arr is list &&
        arr.size() <= maxLen &&
        (arr.size() == 0 || arr[0] is map);
    }

    // Validation Blueprint: UserAccount
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'familyGuard',
          'activeProfileId',
          'activeServerId',
          'favorites',
          'watchQueue',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'familyGuard',
          'activeProfileId',
          'activeServerId',
          'favorites',
          'watchQueue',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() <= 120 &&
        data.email is string &&
        data.email.size() <= 200 &&
        data.photoURL is string &&
        data.photoURL.size() <= 500 &&
        data.familyGuard is bool &&
        data.activeProfileId is string &&
        data.activeProfileId.size() <= 20 &&
        data.activeProfileId in ['imperial', 'family', 'kids'] &&
        data.activeServerId is string &&
        isValidId(data.activeServerId) &&
        isValidStringList(data.favorites, 200) &&
        isValidStringList(data.watchQueue, 50) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserServer
    function isValidUserServer(data, userId, serverId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'name',
          'type',
          'host',
          'username',
          'password',
          'm3uContent',
          'useProxy',
          'addedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'type',
          'host',
          'username',
          'password',
          'm3uContent',
          'useProxy',
          'addedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string &&
        isValidId(data.id) &&
        data.id == serverId &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 120 &&
        data.type is string &&
        data.type.size() <= 20 &&
        data.type in ['xtream', 'm3u'] &&
        data.host is string &&
        data.host.size() >= 1 &&
        data.host.size() <= 500 &&
        data.username is string &&
        data.username.size() <= 120 &&
        data.password is string &&
        data.password.size() <= 120 &&
        data.m3uContent is string &&
        data.m3uContent.size() <= 50000 &&
        data.useProxy is bool &&
        data.addedAt is number &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserAiSession
    function isValidUserAiSession(data, userId, sessionId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'title',
          'updatedAtMs',
          'messages',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerId',
          'title',
          'updatedAtMs',
          'messages',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string &&
        isValidId(data.id) &&
        data.id == sessionId &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        data.updatedAtMs is number &&
        isValidMapList(data.messages, 40) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection 1: Private User Accounts (PII isolated to Owner only, no list)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: Update Preferences & Synced Lists
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'email',
            'photoURL',
            'familyGuard',
            'activeProfileId',
            'activeServerId',
            'favorites',
            'watchQueue',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      // Collection 2: Private User Saved Servers (Master Gate enforces parent user exists)
      match /servers/{serverId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(serverId) &&
          isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow list: if isSignedIn() &&
          isOwner(userId) &&
          resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(serverId) &&
          isOwner(userId) &&
          isValidUserServer(incoming(), userId, serverId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(serverId) &&
          isOwner(userId) &&
          isValidUserServer(incoming(), userId, serverId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          (
            // Action: Update Server Settings
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'host',
              'username',
              'password',
              'm3uContent',
              'useProxy',
              'updatedAt'
            ])
          );

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(serverId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }

      // Collection 3: Private User AI Studio Synced Sessions
      match /aiSessions/{sessionId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow list: if isSignedIn() &&
          isOwner(userId) &&
          resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          isOwner(userId) &&
          isValidUserAiSession(incoming(), userId, sessionId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          isOwner(userId) &&
          isValidUserAiSession(incoming(), userId, sessionId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          (
            // Action: Update AI Conversation History
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'updatedAtMs',
              'messages',
              'updatedAt'
            ])
          );

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
